{
  "name": "BauGest",
  "short_name": "BauGest",
  "description": "Photos, documents et plans de chantier rangés dans Google Drive",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#131518",
  "theme_color": "#131518",
  "lang": "fr",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
          ]
        },
        {
          "name": "plans",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "id": "./"
}
